# Backend Environment Variables Template
# Copy this to backend/.env and fill in your actual values
# NEVER commit this file to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Format: postgresql://username:password@host:port/database_name
# Local development example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_palmistry
# 
# Render PostgreSQL example:
# DATABASE_URL=postgresql://[user]:[password]@[render-host]:[5432]/[database_name]
#
# Railway PostgreSQL example:
# DATABASE_URL=postgresql://[user]:[password]@containers-us-west-xxx.railway.app:[port]/railway
#
# Supabase example:
# DATABASE_URL=postgresql://[postgres.xxx.supabase.co]:5432/postgres?password=[password]
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_palmistry

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST be at least 32 characters, use a strong random string
SECRET_KEY=EYm9KxZnau4Z_qhzimxvfNiTmuVxHUyBwTP_yg_KPgs

# JWT algorithm - typically HS256
ALGORITHM=HS256

# JWT token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# GOOGLE GEMINI AI SERVICE
# ============================================
# Get from: https://aistudio.google.com
# 1. Visit the Google AI Studio
# 2. Click "Create API Key"
# 3. Copy the generated API key
GEMINI_API_KEY=YOUR_NEW_GEMINI_API_KEY

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# URL where your React frontend is hosted
# Development: http://localhost:3000 or http://localhost:5173
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# Development: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Production: https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# OPTIONAL: LOGGING & MONITORING
# ============================================
# LOG_LEVEL=info
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
