# Frontend Environment Variables Template
# Copy this to frontend/.env.local and fill in your actual values
# NEVER commit .env.local to version control
# .env.example and .env.production are safe to commit

# ============================================
# VITE API CONFIGURATION
# ============================================
# Backend API base URL
# Development: http://127.0.0.1:8000 or http://localhost:8000
# Production: https://api.your-domain.com or https://your-api-domain.render.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: Enable debug logging
# VITE_DEBUG=true
